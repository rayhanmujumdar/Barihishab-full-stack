BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=barihishab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barihishab
POSTGRES_PORT=5432

# API docs (Swagger UI at /api/v1/docs). Always on in dev; set "true" to expose in production.
API_DOCS_ENABLED=false
# Diagnostic endpoints that write to the DB (POST /api/v1/health/db). Same rule.
API_DIAGNOSTICS_ENABLED=false

# Prisma
DATABASE_URL="postgresql://barihishab:change-me@localhost:5432/barihishab?schema=public"

# Auth — JWT access token (15 min) signing key. Generate: openssl rand -base64 48
AUTH_JWT_SECRET=
# Public origin of the app; used for CSRF Origin checks and email links.
APP_URL=http://localhost:3000
# Set "true" only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Email (Resend). Leave RESEND_API_KEY empty in dev: links are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="BariHisab <no-reply@your-domain.com>"

# First Super Admin, created by `pnpm db:seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=

# File storage (bills/receipts): any S3-compatible private bucket.
# Dev/test: RustFS from docker-compose (`pnpm db:up`). Prod: Cloudflare R2.
# S3_ENDPOINT / S3_PUBLIC_ENDPOINT must also be set when running `pnpm build`:
# next.config.ts bakes the bucket origin into the CSP headers at build time.
S3_ENDPOINT=http://127.0.0.1:9000
# Origin the *browser* uses for presigned URLs (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=barihishab
S3_ACCESS_KEY_ID=barihishab
S3_SECRET_ACCESS_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true

# `pnpm db:seed` also creates the PRD demo units and fund accounts when "true".
SEED_DEMO=false

# `pnpm db:seed:test-users` (local manual testing only). Pin the shared test
# password (≥ 12 chars); leave empty for a random one printed on each run.
# The script refuses non-local databases unless ALLOW_TEST_USERS_SEED=true.
TEST_USERS_PASSWORD=
ALLOW_TEST_USERS_SEED=false

# Integration tests (must end in _test; schema is dropped on every run).
DATABASE_URL_TEST="postgresql://barihishab:change-me@localhost:5432/barihishab_test?schema=public"
