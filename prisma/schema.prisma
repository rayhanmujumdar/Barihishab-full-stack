// Prisma schema — https://pris.ly/d/prisma-schema
// Connection URL lives in prisma.config.ts (Prisma 7 no longer reads it here).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Throwaway table used by `pnpm db:check` to prove the
// Docker Postgres <-> Prisma wiring works end to end.
model ConnectionTest {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("connection_tests")
}

// ─── Auth & authorization (docs/barihishab_authentication_autorization.md §6) ───
// The auth_foundation migration also holds hand-written SQL Prisma can't
// express: citext extension, username CHECK, the user_roles COALESCE unique
// index, partial indexes on sessions/auth_tokens, and the audit_logs
// append-only triggers. If `migrate dev` ever proposes dropping them, keep them.

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum Locale {
  bn
  en
}

enum Role {
  SUPER_ADMIN
  OWNER
  ACCOUNTANT
  VIEWER
}

enum AuthTokenType {
  INVITE
  RESET
}

enum EmailTemplate {
  INVITE
  RESET
  PASSWORD_CHANGED
  REQUEST_UPDATE
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

// One row in v1; every property-scoped table references it.
model Property {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("BDT")
  timezone  String   @default("Asia/Dhaka")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles           UserRole[]
  periods         Period[]
  units           Unit[]
  fundAccounts    FundAccount[]
  categories      Category[]
  transactions    HouseTransaction[]
  attachments     Attachment[]
  idempotencyKeys IdempotencyKey[]
  loanMovements   LoanMovement[]
  owners          Owner[]
  shareSets       ShareSet[]
  ledgerEntries   OwnerLedgerEntry[]
  loans           Loan[]
  periodReopens   PeriodReopen[]
  moneyRequests   MoneyRequest[]

  @@map("properties")
}

// better-auth `user` model + BariHisab profile columns. No financial data.
// The password hash lives in `accounts` (provider_id = 'credential').
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String
  email               String     @unique @db.Citext
  emailVerified       Boolean    @default(false) @map("email_verified")
  image               String?
  username            String     @unique @db.Citext
  displayUsername     String     @map("display_username")
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  surname             String?
  birthday            DateTime?  @db.Date
  profession          String?
  phone               String?
  whatsapp            String?
  whatsappSameAsPhone Boolean    @default(false) @map("whatsapp_same_as_phone")
  houseResponsibility String?    @map("house_responsibility")
  locale              Locale     @default(bn)
  status              UserStatus @default(INVITED)
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  tokenVersion        Int        @default(0) @map("token_version")
  /// Current profile photo (add-profile-photo D2); an `attachments` row with entity_type 'user_avatar'.
  avatarAttachmentId  String?    @unique @map("avatar_attachment_id") @db.Uuid
  createdById         String?    @map("created_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy    User?         @relation("UserCreatedBy", fields: [createdById], references: [id])
  avatar       Attachment?   @relation("UserAvatar", fields: [avatarAttachmentId], references: [id], onDelete: Restrict)
  created      User[]        @relation("UserCreatedBy")
  accounts     Account[]
  baSessions   BaSession[]
  roles        UserRole[]    @relation("UserRoles")
  grants       UserRole[]    @relation("RoleGrantedBy")
  sessions     AuthSession[]
  authTokens   AuthToken[]   @relation("AuthTokenUser")
  issuedTokens AuthToken[]   @relation("AuthTokenCreatedBy")
  emails       EmailOutbox[]

  closedPeriods      Period[]           @relation("PeriodClosedBy")
  txnsCreated        HouseTransaction[] @relation("TxnCreatedBy")
  txnsUpdated        HouseTransaction[] @relation("TxnUpdatedBy")
  txnsVoided         HouseTransaction[] @relation("TxnVoidedBy")
  attachmentsAdded   Attachment[]       @relation("AttachmentUploadedBy")
  attachmentsRemoved Attachment[]       @relation("AttachmentRemovedBy")

  owners          Owner[]            @relation("OwnerUser")
  shareSetsSaved  ShareSet[]         @relation("ShareSetCreatedBy")
  ledgerCreated   OwnerLedgerEntry[] @relation("LedgerCreatedBy")
  ledgerVoided    OwnerLedgerEntry[] @relation("LedgerVoidedBy")
  loansCreated    Loan[]             @relation("LoanCreatedBy")
  loanMovesMade   LoanMovement[]     @relation("LoanMovementCreatedBy")
  loanMovesVoid   LoanMovement[]     @relation("LoanMovementVoidedBy")
  periodReopens   PeriodReopen[]     @relation("PeriodReopenedBy")
  requestsMade    MoneyRequest[]     @relation("RequestCreatedBy")
  requestsDecided MoneyRequest[]     @relation("RequestDecidedBy")

  @@index([status])
  @@map("users")
}

// better-auth `account` model; holds the Argon2id password hash.
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// better-auth `verification` model (required by the library; identifiers hashed).
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

// better-auth's own `session` model. Unused: BariHisab issues its own
// access/refresh tokens (see AuthSession). Kept so the adapter schema is complete.
model BaSession {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ba_sessions")
}

// System role grants. property_id NULL = global. Uniqueness over
// (user_id, coalesce(property_id), role) is enforced by a SQL index in the migration.
model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  propertyId  String?  @map("property_id") @db.Uuid
  role        Role
  grantedById String?  @map("granted_by") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user      User      @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: NULL property means "global", so deleting a property must never
  // silently widen its scoped grants via SET NULL.
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  grantedBy User?     @relation("RoleGrantedBy", fields: [grantedById], references: [id])

  @@index([role])
  @@map("user_roles")
}

// Refresh-token store. Only the SHA-256 hash of the refresh token is kept.
model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  remember      Boolean   @default(false)
  ip            String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt DateTime? @map("idle_expires_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("sessions")
}

// Single-use INVITE (72 h) and RESET (1 h) tokens, stored as SHA-256 hashes.
model AuthToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  type        AuthTokenType
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime?     @map("used_at") @db.Timestamptz(6)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdById String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation("AuthTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AuthTokenCreatedBy", fields: [createdById], references: [id])

  @@map("auth_tokens")
}

// INSERT-only (trigger + REVOKE in the migration). No FK to users on purpose:
// the log must outlive and never block changes to the rows it describes.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// Transactional outbox; a worker sends, the API never emails directly.
model EmailOutbox {
  id                String        @id @default(uuid()) @db.Uuid
  toUserId          String?       @map("to_user_id") @db.Uuid
  toEmail           String        @map("to_email")
  template          EmailTemplate
  locale            Locale        @default(bn)
  payload           Json          @default("{}")
  status            EmailStatus   @default(QUEUED)
  attempts          Int           @default(0)
  nextAttemptAt     DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?       @map("last_error")
  sentAt            DateTime?     @map("sent_at") @db.Timestamptz(6)
  providerMessageId String?       @map("provider_message_id")
  dedupeKey         String        @unique @map("dedupe_key")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  toUser User? @relation(fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

// Fixed-window counters for login / reset rate limits.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)

  @@map("rate_limits")
}

// ─── Income & Expenses (docs/income_expense_PRD.md §9) ───
// The income_expenses migration also holds hand-written SQL Prisma can't
// express: amount/from_reserve/void CHECKs, the closed-period trigger,
// the no-delete triggers and partial indexes. Keep them if `migrate dev`
// ever proposes dropping them.

enum PeriodStatus {
  OPEN
  CLOSED
}

enum FundType {
  CASH
  BANK
  WALLET
}

enum TxnKind {
  INCOME
  EXPENSE
}

enum TxnSource {
  MANUAL
  GENERATED_RENT
  ADJUSTMENT
  LOAN_WRITE_OFF
  REQUEST_GRANT
}

// One accounting month. `month` is the 1st of the month.
model Period {
  id                    String       @id @default(uuid()) @db.Uuid
  propertyId            String       @map("property_id") @db.Uuid
  month                 DateTime     @db.Date
  status                PeriodStatus @default(OPEN)
  closedAt              DateTime?    @map("closed_at") @db.Timestamptz(6)
  closedById            String?      @map("closed_by") @db.Uuid
  // Distribution (design D1): saved on close, kept on reopen until re-close.
  reopenCount           Int          @default(0) @map("reopen_count")
  snapshot              Json?
  reserveOverridePaisa  BigInt?      @map("reserve_override_paisa")
  reserveOverrideReason String?      @map("reserve_override_reason")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  property         Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  closedBy         User?              @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  transactions     HouseTransaction[] @relation("TxnPeriod")
  referencedBy     HouseTransaction[] @relation("TxnReferencePeriod")
  ledgerEntries    OwnerLedgerEntry[] @relation("LedgerPeriod")
  loanMovements    LoanMovement[]
  ledgerReferenced OwnerLedgerEntry[] @relation("LedgerReferencePeriod")
  reopens          PeriodReopen[]

  @@unique([propertyId, month])
  @@map("periods")
}

// Reopen history (Distribution PRD F7, G7): who, when, why, and the snapshot
// the month had before, for the re-close before → after view (F8).
model PeriodReopen {
  id             String   @id @default(uuid()) @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  periodId       String   @map("period_id") @db.Uuid
  reason         String
  reopenedById   String   @map("reopened_by") @db.Uuid
  reopenedAt     DateTime @default(now()) @map("reopened_at") @db.Timestamptz(6)
  snapshotBefore Json?    @map("snapshot_before")

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  period     Period   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  reopenedBy User     @relation("PeriodReopenedBy", fields: [reopenedById], references: [id], onDelete: Restrict)

  @@index([periodId, reopenedAt])
  @@map("period_reopens")
}

model Unit {
  id                   String   @id @default(uuid()) @db.Uuid
  propertyId           String   @map("property_id") @db.Uuid
  name                 String
  tenantName           String?  @map("tenant_name")
  rentPaisa            BigInt   @default(0) @map("default_rent_paisa")
  defaultFundAccountId String?  @map("default_fund_account_id") @db.Uuid
  sortOrder            Int      @default(0) @map("sort_order")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property           Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  defaultFundAccount FundAccount?       @relation(fields: [defaultFundAccountId], references: [id], onDelete: Restrict)
  transactions       HouseTransaction[]

  @@unique([propertyId, name])
  @@map("units")
}

model FundAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  propertyId          String   @map("property_id") @db.Uuid
  name                String
  type                FundType
  openingBalancePaisa BigInt   @default(0) @map("opening_balance_paisa")
  openingDate         DateTime @map("opening_date") @db.Date
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  units         Unit[]
  transactions  HouseTransaction[]
  ledgerEntries OwnerLedgerEntry[]
  loans         Loan[]
  loanMovements LoanMovement[]

  @@map("fund_accounts")
}

model Category {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  kind       TxnKind
  code       String
  nameEn     String   @map("name_en")
  nameBn     String   @map("name_bn")
  isSystem   Boolean  @default(false) @map("is_system")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  transactions HouseTransaction[]

  @@unique([propertyId, code])
  @@map("categories")
}

// Income and expenses in one table. Amounts are always positive paisa;
// `kind` gives the direction. Never deleted — voided with a reason.
model HouseTransaction {
  id                 String    @id @default(uuid()) @db.Uuid
  propertyId         String    @map("property_id") @db.Uuid
  periodId           String    @map("period_id") @db.Uuid
  kind               TxnKind
  categoryId         String    @map("category_id") @db.Uuid
  unitId             String?   @map("unit_id") @db.Uuid
  amountPaisa        BigInt    @map("amount_paisa")
  txnDate            DateTime  @map("txn_date") @db.Date
  fundAccountId      String    @map("fund_account_id") @db.Uuid
  vendor             String?
  description        String?
  fromReserve        Boolean   @default(false) @map("from_reserve")
  referencePeriodId  String?   @map("reference_period_id") @db.Uuid
  source             TxnSource @default(MANUAL)
  isCorrected        Boolean   @default(false) @map("is_corrected")
  /// Owner who received a special grant (main PRD §9.3); set only by request disbursal.
  beneficiaryOwnerId String?   @map("beneficiary_owner_id") @db.Uuid
  /// The money request this expense pays out (Requests PRD F7); one expense per request.
  requestId          String?   @unique @map("request_id") @db.Uuid
  voidedAt           DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedById         String?   @map("voided_by") @db.Uuid
  voidReason         String?   @map("void_reason")
  createdById        String    @map("created_by") @db.Uuid
  updatedById        String?   @map("updated_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  period          Period        @relation("TxnPeriod", fields: [periodId], references: [id], onDelete: Restrict)
  referencePeriod Period?       @relation("TxnReferencePeriod", fields: [referencePeriodId], references: [id], onDelete: Restrict)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit            Unit?         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  fundAccount     FundAccount   @relation(fields: [fundAccountId], references: [id], onDelete: Restrict)
  createdBy       User          @relation("TxnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?         @relation("TxnUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  voidedBy        User?         @relation("TxnVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  beneficiary     Owner?        @relation("TxnBeneficiary", fields: [beneficiaryOwnerId], references: [id], onDelete: Restrict)
  request         MoneyRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([periodId, categoryId])
  @@map("house_transactions")
}

// Bills & receipts in the private bucket. Created unlinked at presign time
// (entity_id NULL) and linked to an entry later; removal is soft.
model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  propertyId   String    @map("property_id") @db.Uuid
  entityType   String    @default("house_transaction") @map("entity_type")
  entityId     String?   @map("entity_id") @db.Uuid
  storageKey   String    @unique @map("storage_key")
  fileName     String    @map("file_name")
  mime         String
  sizeBytes    Int       @map("size_bytes")
  uploadedById String    @map("uploaded_by") @db.Uuid
  linkedAt     DateTime? @map("linked_at") @db.Timestamptz(6)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(6)
  removedById  String?   @map("removed_by") @db.Uuid
  /// Request files only (Requests PRD F15): visible to the requester and Super Admin even after payout.
  isPrivate    Boolean   @default(false) @map("is_private")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  removedBy  User?    @relation("AttachmentRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)
  avatarOf   User?    @relation("UserAvatar")

  @@map("attachments")
}

// Idempotency-Key replay store (DUP-01): same key + same body → same response.
model IdempotencyKey {
  propertyId  String   @map("property_id") @db.Uuid
  key         String
  requestHash String   @map("request_hash") @db.Char(64)
  status      Int
  body        Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@id([propertyId, key])
  @@map("idempotency_keys")
}

// ─── Owners (docs/owners_sections_PRD.md, PRD §5.4–5.5, §9.2–9.3) ───
// The owners migration also holds hand-written SQL Prisma can't express:
// ledger sign/void CHECKs, the one-OPENING and one-active-share-set partial
// indexes, the closed-period trigger (void marking allowed) and the
// no-delete triggers. Keep them if `migrate dev` ever proposes dropping them.

enum LedgerType {
  OPENING
  ENTITLEMENT
  PAYOUT
  ADVANCE
  LOAN_DEDUCTION
  ADJUSTMENT
  REVERSAL
}

enum PayMethod {
  CASH
  BANK
  BKASH
  NAGAD
}

enum LoanStatus {
  ACTIVE
  REPAID
  WRITTEN_OFF
  CANCELLED
}

// Where an entry or loan came from (Advances & Loans design D2).
enum EntryOrigin {
  DIRECT
  CLOSE
  PAYOUT_SPLIT
  REQUEST
}

// Cash-side loan events (design D1). Deductions stay in the owner ledger.
enum LoanMovementType {
  CASH_REPAYMENT
  REVERSAL
  CANCELLATION
  WRITE_OFF
}

// A person or estate holding part of the house; may have no login. Never deleted.
model Owner {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  initials    String
  sortOrder   Int      @default(0) @map("sort_order")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user       User?              @relation("OwnerUser", fields: [userId], references: [id], onDelete: Restrict)
  shareItems ShareSetItem[]
  entries    OwnerLedgerEntry[]
  loans      Loan[]
  requests   MoneyRequest[]
  grants     HouseTransaction[] @relation("TxnBeneficiary")

  @@unique([propertyId, userId])
  @@map("owners")
}

// All owners' units together, valid from the 1st of a month. A same-month
// re-save marks the old set replaced (kept for history).
model ShareSet {
  id            String    @id @default(uuid()) @db.Uuid
  propertyId    String    @map("property_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  reason        String
  createdById   String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  replacedAt    DateTime? @map("replaced_at") @db.Timestamptz(6)

  property  Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdBy User           @relation("ShareSetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     ShareSetItem[]

  @@index([propertyId, effectiveFrom])
  @@map("share_sets")
}

model ShareSetItem {
  shareSetId String @map("share_set_id") @db.Uuid
  ownerId    String @map("owner_id") @db.Uuid
  units      Int

  shareSet ShareSet @relation(fields: [shareSetId], references: [id], onDelete: Restrict)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@id([shareSetId, ownerId])
  @@map("share_set_items")
}

// The owner ledger (PRD §5.4). Signed paisa: + the house owes more, − less.
// Balance = Σ amount (voided originals and their reversals cancel).
model OwnerLedgerEntry {
  id                String      @id @default(uuid()) @db.Uuid
  propertyId        String      @map("property_id") @db.Uuid
  ownerId           String      @map("owner_id") @db.Uuid
  periodId          String      @map("period_id") @db.Uuid
  type              LedgerType
  amountPaisa       BigInt      @map("amount_paisa")
  entryDate         DateTime    @map("entry_date") @db.Date
  fundAccountId     String?     @map("fund_account_id") @db.Uuid
  method            PayMethod?
  referenceNo       String?     @map("reference_no")
  note              String?
  referencePeriodId String?     @map("reference_period_id") @db.Uuid
  reversesId        String?     @unique @map("reverses_id") @db.Uuid
  isSelf            Boolean     @default(false) @map("is_self")
  flagged           Boolean     @default(false)
  createdById       String      @map("created_by") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt          DateTime?   @map("voided_at") @db.Timestamptz(6)
  voidedById        String?     @map("voided_by") @db.Uuid
  voidReason        String?     @map("void_reason")
  loanId            String?     @map("loan_id") @db.Uuid
  origin            EntryOrigin @default(DIRECT)
  /// The money request this advance pays out (Requests PRD F7); one entry per request.
  requestId         String?     @unique @map("request_id") @db.Uuid

  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  owner           Owner             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  request         MoneyRequest?     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  period          Period            @relation("LedgerPeriod", fields: [periodId], references: [id], onDelete: Restrict)
  referencePeriod Period?           @relation("LedgerReferencePeriod", fields: [referencePeriodId], references: [id], onDelete: Restrict)
  fundAccount     FundAccount?      @relation(fields: [fundAccountId], references: [id], onDelete: Restrict)
  reverses        OwnerLedgerEntry? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy      OwnerLedgerEntry? @relation("LedgerReversal")
  createdBy       User              @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy        User?             @relation("LedgerVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  loans           Loan[]            @relation("LoanPayoutEntry")
  loan            Loan?             @relation("LoanDeductions", fields: [loanId], references: [id], onDelete: Restrict)

  @@index([ownerId, periodId])
  @@index([fundAccountId])
  @@index([loanId])
  @@map("owner_ledger_entries")
}

// Loan ledger (PRD §5.5; Advances & Loans PRD). Outstanding is computed from
// linked LOAN_DEDUCTIONs and loan_movements — never stored.
model Loan {
  id               String      @id @default(uuid()) @db.Uuid
  propertyId       String      @map("property_id") @db.Uuid
  number           Int
  origin           EntryOrigin @default(DIRECT)
  isSelf           Boolean     @default(false) @map("is_self")
  flagged          Boolean     @default(false)
  ownerId          String      @map("owner_id") @db.Uuid
  principalPaisa   BigInt      @map("principal_paisa")
  disbursedOn      DateTime    @map("disbursed_on") @db.Date
  fundAccountId    String      @map("fund_account_id") @db.Uuid
  method           PayMethod
  referenceNo      String?     @map("reference_no")
  reason           String
  installmentPaisa BigInt?     @map("installment_paisa")
  status           LoanStatus  @default(ACTIVE)
  payoutEntryId    String?     @map("payout_entry_id") @db.Uuid
  /// The money request this loan pays out (Requests PRD F7); one loan per request.
  requestId        String?     @unique @map("request_id") @db.Uuid
  createdById      String      @map("created_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  owner       Owner              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  fundAccount FundAccount        @relation(fields: [fundAccountId], references: [id], onDelete: Restrict)
  payoutEntry OwnerLedgerEntry?  @relation("LoanPayoutEntry", fields: [payoutEntryId], references: [id], onDelete: Restrict)
  deductions  OwnerLedgerEntry[] @relation("LoanDeductions")
  movements   LoanMovement[]
  createdBy   User               @relation("LoanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  request     MoneyRequest?      @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([propertyId, number])
  @@index([ownerId, status])
  @@map("loans")
}

// Cash repayments, their reversals, cancellations and write-offs (design D1).
// amount_paisa is the signed effect on the loan outstanding; the fund account
// moves by its negative. Never deleted; voided with a reason.
model LoanMovement {
  id            String           @id @default(uuid()) @db.Uuid
  propertyId    String           @map("property_id") @db.Uuid
  loanId        String           @map("loan_id") @db.Uuid
  periodId      String           @map("period_id") @db.Uuid
  type          LoanMovementType
  amountPaisa   BigInt           @map("amount_paisa")
  movementDate  DateTime         @map("movement_date") @db.Date
  fundAccountId String           @map("fund_account_id") @db.Uuid
  method        PayMethod?
  referenceNo   String?          @map("reference_no")
  note          String?
  reversesId    String?          @unique @map("reverses_id") @db.Uuid
  createdById   String           @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt      DateTime?        @map("voided_at") @db.Timestamptz(6)
  voidedById    String?          @map("voided_by") @db.Uuid
  voidReason    String?          @map("void_reason")

  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  loan        Loan          @relation(fields: [loanId], references: [id], onDelete: Restrict)
  period      Period        @relation(fields: [periodId], references: [id], onDelete: Restrict)
  fundAccount FundAccount   @relation(fields: [fundAccountId], references: [id], onDelete: Restrict)
  reverses    LoanMovement? @relation("LoanMovementReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy  LoanMovement? @relation("LoanMovementReversal")
  createdBy   User          @relation("LoanMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy    User?         @relation("LoanMovementVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([loanId])
  @@index([fundAccountId])
  @@map("loan_movements")
}

// ─── Requests (docs/requests_section_PRD.md; main PRD §9.4 money_requests) ───
// The requests migration also holds hand-written SQL Prisma can't express:
// amount CHECKs, the no-delete trigger. The paid-out entry points back here
// through request_id on owner_ledger_entries / loans / house_transactions.

enum RequestType {
  ADVANCE
  LOAN
  GRANT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
  DISBURSED
}

model MoneyRequest {
  id                   String        @id @default(uuid()) @db.Uuid
  propertyId           String        @map("property_id") @db.Uuid
  /// Asia/Dhaka year of submission; numbers restart every year (R-2026-014).
  year                 Int
  number               Int
  ownerId              String        @map("owner_id") @db.Uuid
  type                 RequestType
  amountRequestedPaisa BigInt        @map("amount_requested_paisa")
  amountApprovedPaisa  BigInt?       @map("amount_approved_paisa")
  reason               String
  neededBy             DateTime      @map("needed_by") @db.Date
  repaymentPlan        String?       @map("repayment_plan")
  status               RequestStatus @default(PENDING)
  isSelf               Boolean       @default(false) @map("is_self")
  recordedOnBehalf     Boolean       @default(false) @map("recorded_on_behalf")
  createdById          String        @map("created_by") @db.Uuid
  decidedById          String?       @map("decided_by") @db.Uuid
  decidedAt            DateTime?     @map("decided_at") @db.Timestamptz(6)
  decisionNote         String?       @map("decision_note")
  /// The requester hasn't seen the latest decision yet (nav badge, F1).
  decisionUnseen       Boolean       @default(false) @map("decision_unseen")
  disbursedAt          DateTime?     @map("disbursed_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  owner       Owner             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  decidedBy   User?             @relation("RequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  ledgerEntry OwnerLedgerEntry?
  loan        Loan?
  transaction HouseTransaction?

  @@unique([propertyId, year, number])
  @@index([propertyId, status])
  @@index([ownerId])
  @@map("money_requests")
}
